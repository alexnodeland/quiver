{
  "name": "@quiver-dsp/react",
  "version": "0.3.3",
  "description": "React utilities for Quiver modular synthesizer",
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "quiver",
    "modular",
    "synthesizer",
    "audio",
    "react",
    "react-flow"
  ],
  "author": "Quiver Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexnodeland/quiver"
  },
  "homepage": "https://github.com/alexnodeland/quiver#readme",
  "bugs": {
    "url": "https://github.com/alexnodeland/quiver/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@quiver-dsp/types": "^0.3.3",
    "@quiver-dsp/wasm": "^0.3.3"
  },
  "peerDependencies": {
    "@xyflow/react": ">=12.0.0",
    "react": ">=18.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@xyflow/react": "^12.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.0.0"
  }
}
